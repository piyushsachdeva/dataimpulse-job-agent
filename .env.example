# DataImpulse credentials — dashboard → Proxy → "Login" / "Password"
DATAIMPULSE_LOGIN=your_login
DATAIMPULSE_PASSWORD=your_password

# Gateway. 823 = rotating residential (new IP per request).
# For a sticky IP use a port from the sticky range shown in your dashboard (e.g. 10000).
DATAIMPULSE_HOST=gw.dataimpulse.com
DATAIMPULSE_PORT=823

# Sticky session port (same IP for the duration set in the dashboard, up to 120 min).
# Check the sticky port range shown in your dashboard's "Basic URL example".
DATAIMPULSE_STICKY_PORT=10000

# http (HTTP/HTTPS) or socks5 — both are supported by DataImpulse
DATAIMPULSE_PROTOCOL=http

# Used only for the cost estimate in receipts ($1/GB residential, $2/GB mobile)
DATAIMPULSE_PRICE_PER_GB=1

# Optional exit country (ISO-2, lowercase). Appended to the login as __cr.<code>.
DATAIMPULSE_COUNTRY=us

# Set to 0 to bypass the proxy entirely (useful for debugging)
USE_PROXY=1

